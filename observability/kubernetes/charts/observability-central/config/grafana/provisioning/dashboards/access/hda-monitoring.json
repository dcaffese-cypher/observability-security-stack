    {
      "id": 41,
      "title": "HDA nginx access logs",
      "type": "logs",
      "gridPos": {
        "h": 12,
        "w": 16,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "team:=\"access\" \"service.name\":=\"hda\" job:=\"nginx_hda\" | format \"<timestamp> <client_ip> <status> <response_size> <request>\" | sort by (_time) desc",
          "queryType": "range",
          "refId": "A",
          "maxLines": 500
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
